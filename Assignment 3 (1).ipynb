   "source": [
    "#Assignment 3: To check whether or not the triangle is a right angled-triangle using function\n",
    "def right_triangle(a,b,c):\n",
    "    if a*a + b*b == c*c:\n",
    "        print(\"Right Angled Triangle\")\n",
    "    else:\n",
    "        print(\"Not a right angled triangle\")\n",
    "right_triangle(3,4,5)"
   ]
